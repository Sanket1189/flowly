# Add either a UPI ID or a hosted donation/payment link.
# If both are present, the hosted URL is used.
VITE_DONATION_UPI_ID=
VITE_DONATION_URL=

# Optional deployment overrides. GitHub project pages are detected automatically.
# Set VITE_SITE_URL only when using a custom domain.
VITE_SITE_URL=
VITE_BASE_PATH=
